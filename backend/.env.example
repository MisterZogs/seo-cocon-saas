# ============ IA ============
ANTHROPIC_API_KEY=sk-ant-...

# ============ Keyword data / SERP / Backlinks ============
# DataForSEO (optionnel — mode mock si absent, utile pour dev/tests sans coût)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Localisation par défaut pour DataForSEO (2250 = France, 2840 = USA)
DATAFORSEO_LOCATION_CODE=2250
DATAFORSEO_LANGUAGE_CODE=fr

# ============ Base de données (Postgres) ============
# Optionnel en dev : sans DATABASE_URL, les runs ne sont pas persistés et
# l'historique se limite au TTL Redis de 24h. Le pipeline fonctionne quand même.
DATABASE_URL=postgresql://cocon:motdepasse@localhost:5432/cocon_prod

# ============ Authentification des agences ============
# OBLIGATOIRE — sans lui le backend refuse de démarrer (cf. backend/auth.py).
# 32 caractères minimum. Générer :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Durée de validité d'un jeton, en heures (défaut 168 = 7 jours)
JWT_EXPIRE_HOURS=168

# ⚠️ L'auth a besoin de DATABASE_URL : les comptes vivent dans la table
# `agencies`. Sans Postgres, /auth/* et toutes les routes protégées répondent 503.

# ============ Queue (Redis) ============
REDIS_URL=redis://localhost:6379/0

# ============ App ============
ENV=development
LOG_LEVEL=INFO
