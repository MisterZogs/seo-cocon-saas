# ============ IA ============
ANTHROPIC_API_KEY=sk-ant-...

# ============ Keyword data / SERP / Backlinks ============
# DataForSEO (optionnel — mode mock si absent, utile pour dev/tests sans coût)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Localisation par défaut pour DataForSEO (2250 = France, 2840 = USA)
DATAFORSEO_LOCATION_CODE=2250
DATAFORSEO_LANGUAGE_CODE=fr

# ============ Supabase (DB + Auth + Storage) ============
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============ Queue (Upstash Redis) ============
REDIS_URL=redis://localhost:6379/0

# ============ App ============
ENV=development
LOG_LEVEL=INFO
