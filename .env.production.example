# =========================================================
# Configuration production — à copier vers .env sur le VPS
# =========================================================

# Domaine public (Caddy fera l'HTTPS automatique via Let's Encrypt)
DOMAIN=cocon.example.com

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- DataForSEO (optionnel — mock si absent) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2250
DATAFORSEO_LANGUAGE_CODE=fr

# ---- Postgres (persistance des runs) ----
# Mot de passe du service `db` du docker-compose. Générer une valeur aléatoire :
#   openssl rand -base64 32
# DATABASE_URL est construit automatiquement par le compose à partir d'ici.
DB_PASSWORD=

# ---- Authentification des agences ----
# Secret de signature des JWT. 32 caractères minimum, sinon le backend refuse de
# démarrer. Générer :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le changer invalide tous les jetons émis : tout le monde doit se reconnecter.
JWT_SECRET=
# Durée de validité d'un jeton, en heures (défaut 168 = 7 jours).
JWT_EXPIRE_HOURS=168

# ---- App ----
LOG_LEVEL=INFO
