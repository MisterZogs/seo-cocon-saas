# =========================================================
# Configuration production — à copier vers .env sur le VPS
# =========================================================

# Domaine public (Caddy fera l'HTTPS automatique via Let's Encrypt)
DOMAIN=cocon.example.com

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- DataForSEO (optionnel — mock si absent) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2250
DATAFORSEO_LANGUAGE_CODE=fr

# ---- Supabase (V1 — laisser vide au MVP) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
LOG_LEVEL=INFO
