# =========================================================
# Configuration production — à copier vers .env sur le VPS
# =========================================================

# Domaine public (Caddy fera l'HTTPS automatique via Let's Encrypt)
DOMAIN=cocon.example.com

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- DataForSEO (optionnel — mock si absent) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2250
DATAFORSEO_LANGUAGE_CODE=fr

# ---- Postgres (persistance des runs) ----
# Mot de passe du service `db` du docker-compose. Générer une valeur aléatoire :
#   openssl rand -base64 32
# DATABASE_URL est construit automatiquement par le compose à partir d'ici.
DB_PASSWORD=

# ---- Authentification des agences ----
# Secret de signature des JWT. 32 caractères minimum, sinon le backend refuse de
# démarrer. Générer :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le changer invalide tous les jetons émis : tout le monde doit se reconnecter.
JWT_SECRET=
# Durée de validité d'un jeton, en heures (défaut 168 = 7 jours).
JWT_EXPIRE_HOURS=168

# ---- Paiement Stripe (optionnel) ----
# Sans ces variables, /billing/checkout et /billing/portal répondent 503 et TOUT
# LE RESTE fonctionne : l'essai de 3 cocons et l'attribution manuelle de formule
# suffisent à exploiter l'outil sans paiement en ligne.
#
# Aucun produit n'est à créer dans le tableau de bord Stripe : les tarifs sont
# déclarés en ligne depuis backend/billing.py, seule source de vérité.
STRIPE_SECRET_KEY=
# Secret de signature du webhook, donné par Stripe à la création du point de
# terminaison. OBLIGATOIRE dès que STRIPE_SECRET_KEY est posé : sans lui,
# n'importe qui pourrait créditer un compte en appelant la route.
# URL à déclarer côté Stripe : https://<DOMAIN>/api/billing/webhook
# Événements à cocher : checkout.session.completed,
#   customer.subscription.created, .updated, .deleted
STRIPE_WEBHOOK_SECRET=
# Racine publique du front, pour les retours de paiement. Déduite de DOMAIN si
# elle est absente — à ne renseigner que si le front vit ailleurs.
PUBLIC_BASE_URL=

# ---- Générateur public (aimant à prospects, /outils/cocon) ----
# La seule route sans authentification, et la seule où un inconnu nous coûte de
# l'argent : un appel Haiku, ~$0,01. Les trois plafonds ci-dessous sont
# facultatifs — ces valeurs sont celles appliquées par défaut.
#
# Le troisième est le seul à borner réellement la dépense : les deux premiers
# raisonnent par IP, ce qui n'arrête ni un botnet ni un succès inattendu.
# 300 générations/jour ≈ 3 $/jour au pire.
PUBLIC_HOURLY_LIMIT=3
PUBLIC_DAILY_LIMIT=10
PUBLIC_GLOBAL_DAILY_LIMIT=300

# ---- App ----
LOG_LEVEL=INFO
