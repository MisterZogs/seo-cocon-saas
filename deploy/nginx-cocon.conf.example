# Nginx vhost pour Cocon Sémantique SaaS
# À copier dans /etc/nginx/sites-available/cocon puis symlink dans sites-enabled/
#
# Prérequis :
#   - docker compose up -d --build (ports 127.0.0.1:8010 backend, 127.0.0.1:3010 frontend)
#   - Certbot certif provisionné pour le domaine (voir deploy/README.md)

# --- HTTP → HTTPS ---
server {
    listen 80;
    server_name cocon.178.104.70.16.sslip.io;
    return 301 https://$host$request_uri;
}

# --- HTTPS principal ---
server {
    listen 443 ssl http2;
    server_name cocon.178.104.70.16.sslip.io;

    ssl_certificate /etc/letsencrypt/live/cocon.178.104.70.16.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cocon.178.104.70.16.sslip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # ---- Backend FastAPI sous /api/* (strip prefix) ----
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE : critical pour le stream job progress
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        chunked_transfer_encoding on;
    }

    # ---- Frontend Next.js ----
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    client_max_body_size 10M;
}
